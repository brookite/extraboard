{
	"name": "obsidian-extraboard",
	"version": "0.5.1",
	"description": "Markdown-backed Kanban and calendar boards for Obsidian, mobile-friendly.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"package": "npm run build && node scripts/package-release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"perf:fixture": "esbuild tests/perf/makeBoard.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/extraboard/makeBoard.cjs --log-level=warning && node node_modules/.cache/extraboard/makeBoard.cjs",
		"test:watch": "vitest"
	},
	"keywords": [],
	"license": "0-BSD",
	"dependencies": {
		"preact": "^10.24.3",
		"sortablejs": "^1.15.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@types/sortablejs": "^1.15.8",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10"
	}
}
